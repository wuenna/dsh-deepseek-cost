{
  "name": "dsh-deepseek-cost",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: session and per-turn DeepSeek cost accounting at the official peak/off-peak rates, as a cost pill in the composer dock and a 花费 row in the built-in turn-usage panel.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cost",
    "token-usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuenna/dsh-deepseek-cost.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
